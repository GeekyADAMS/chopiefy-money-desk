{
  "name": "chopiefy-money-desk",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vercel dev",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:live": "tsx --env-file-if-exists=.env.local --test test/live/*.test.ts",
    "verify": "pnpm typecheck && pnpm test",
    "probe:paystack": "tsx --env-file-if-exists=.env.local scripts/probe-paystack.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  }
}
