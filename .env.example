# Copy to .env.local for local runs; set the same names in Vercel for deploys.
# Never commit real values.

# Shared secret Chord sends as "Authorization: Bearer <MCP_TOKEN>". Generate with: openssl rand -hex 32
MCP_TOKEN=

# Paystack TEST secret key only (sk_test_...). The client refuses live keys.
PAYSTACK_SECRET_KEY=

# Payout limits in naira, set by the owner. Payouts above either limit wait for the owner's approval in the Sheet.
# The server refuses to start a payout if these are missing or invalid.
PAYOUT_LIMIT_NGN=100000
DAILY_LIMIT_NGN=300000

# Optional: bank account the Paystack probe resolves and pays in test mode.
PROBE_BANK_CODE=057
PROBE_ACCOUNT_NUMBER=0000000000
